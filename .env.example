# Copy this file to .env before running `docker compose up`.
# Never commit the real .env -- it holds real secrets once filled in.

# ---- Shared MySQL (one instance, 13 schemas -- see mysql-init/) ----
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# ---- Shared JWT signing secret (must be identical everywhere -- auth-service
# issues, the Gateway and every other service only verify). Generate a real one
# with: openssl rand -base64 32 | base64 -w0
JWT_SECRET=c2FtcGxlLXNlY3JldC1rZXktY2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tZW52aXJvbm1lbnQtMzItYnl0ZXMh

# ---- Frontend origin, for the Gateway's CORS filter (your Vercel URL, no trailing slash) ----
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ---- Public domain for the backend, pointed (A record) at this VM's public IP.
# Caddy auto-issues a Let's Encrypt cert for this on first boot. No domain of your
# own? A free option is a DuckDNS subdomain (https://www.duckdns.org) -- see
# DEPLOYMENT.md. This is NOT optional: Vercel serves the frontend over HTTPS, and
# browsers block a HTTPS page from calling a plain-HTTP API ("mixed content").
CADDY_DOMAIN=api.yourdomain.com

# ---- Eureka basic-auth (only change if you also change eureka-server's own defaults) ----
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka_pass

# ---- MinIO (resume-service's file storage) ----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-too

# ---- Upstash Redis (managed, free tier -- replaces the old self-hosted redis
# container). Create one at https://console.upstash.com/redis ("Create Database",
# Regional type, TLS is on by default) then copy these three from its "Connect" tab:
REDIS_HOST=your-db-name.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=change-me-to-your-upstash-password
REDIS_SSL_ENABLED=true

# ---- LLM provider for resume-parser-service / ai-interview-service / coding-assessment-service.
# Pick ONE provider per service via the *_PROVIDER var; only that provider's key is required.
# (coding-assessment-service's var is intentionally named differently from the other
# two -- it's the actual property name already wired in its application.yml.)
RESUME_PARSER_PROVIDER=gemini
AI_INTERVIEW_PROVIDER=gemini
CODING_ASSESSMENT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
# Ollama needs no key but needs its own always-on process -- not included in this
# compose file; only set OLLAMA_BASE_URL if you're running it separately.

# ---- Judge0 (coding-assessment-service's code execution sandbox) ----
# NOT started by this compose file -- see the "Judge0" section of DEPLOYMENT.md.
# Point at a separately-hosted instance, or coding assessments will fail to execute code.
JUDGE0_BASE_URL=http://localhost:2358

# ---- SMTP (notification-service's actual email sending) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Google OAuth2 (auth-service's social login -- optional, dummy values disable it safely) ----
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
