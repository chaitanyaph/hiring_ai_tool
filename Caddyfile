{$CADDY_DOMAIN} {
	encode gzip

	# Angular frontend and the backend API share this one domain. Every real
	# API call is <service-prefix>/api/v1/... (confirmed in every Angular
	# service's BASE_URL constant), so matching on "/api/*" after the prefix
	# -- not just the bare prefix -- is deliberate: candidate-service's route
	# is /candidate/** and Angular's own candidate UI also lives at
	# /candidate/** (e.g. /candidate/dashboard), so a bare /candidate/* match
	# would swallow Angular's own routes into the Gateway and 401 them
	# instead of serving the SPA. Matching /candidate/api/* only is precise.
	# /auth/oauth2/* and /auth/login/oauth2/* are Spring Security's OAuth2 login
	# entry point and callback -- not under /api/, but still real backend paths
	# (Gateway strips "/auth" and forwards to auth-service's own
	# /oauth2/authorization/google and /login/oauth2/code/google), so they need
	# an explicit match alongside the /api/* ones.
	@api path /auth/api/* /auth/oauth2/* /auth/login/oauth2/* /company/api/* /jobs/api/* /candidate/api/* /resume/api/* /application/api/* /resume-parser/api/* /ai-interview/api/* /coding-assessment/api/* /interview-management/api/* /notification/api/* /offer-management/api/* /analytics/api/*
	handle @api {
		reverse_proxy api-gateway-service:8080
	}

	# Angular SPA: serve the built static files, falling back to index.html
	# for any path Angular's own client-side router owns (e.g. /candidate/dashboard
	# is NOT an API path -- deep-linking/refreshing on an Angular route must not 404).
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
